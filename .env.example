# Copy this file to .env for local dev. In production, set these in your host (e.g. Vercel > Settings >
# Environment Variables). Never commit .env.

# --- LLM ---
# gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Leave blank for the provider default
# (gemini: gemini-3.5-flash-lite, openai: gpt-4o-mini, anthropic: claude-sonnet-5-5)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# --- Apify (Instagram scraper) ---
APIFY_TOKEN=
# Actor id uses "~" instead of "/" in API URLs
APIFY_ACTOR=grabd~instagram-profile-scraper
SCRAPE_TIMEOUT_SECONDS=90
MAX_POSTS=12

# --- Published pages (production) ---
# Upstash Redis REST credentials. Vercel's Upstash integration sets KV_REST_API_URL / KV_REST_API_TOKEN
# automatically; either pair works. Without them (local dev) pages are saved to ./.data/stores.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
