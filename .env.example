# Copy this file to .env and fill in your keys. Never commit .env.

# --- Apify (scraper) ---
APIFY_TOKEN=your_apify_token_here
# Actor id uses "~" instead of "/" in API URLs
APIFY_ACTOR=grabd~instagram-profile-scraper
SCRAPE_TIMEOUT_SECONDS=90
MAX_POSTS=12

# --- LLM ---
# anthropic | openai | gemini
LLM_PROVIDER=anthropic
GEMINI_API_KEY=
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=
# Leave blank to use the default for the provider
# (anthropic default: claude-sonnet-5-5, openai default: gpt-4o-mini)
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
